# ========================================
# ChineseMaster 环境变量配置模板
# ========================================
# 复制此文件为 .env 并填入实际值

# ========================================
# 数据库配置
# ========================================

# Vercel Postgres 数据库URL（用于Prisma客户端）
DATABASE_URL="postgresql://username:password@host:5432/dbname?sslmode=require"

# Vercel Postgres 数据库URL（通过pgBouncer连接池）
POSTGRES_PRISMA_URL="postgresql://username:password@host:5432/dbname?pgbouncer=true&sslmode=require"

# Vercel Postgres 直连URL（用于迁移）
POSTGRES_URL_NON_POOLING="postgresql://username:password@host:5432/dbname?sslmode=require"

# ========================================
# JWT认证配置
# ========================================

# JWT密钥（256位随机字符串）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-256-bit-secret-key-change-in-production"

# JWT过期时间
JWT_EXPIRES_IN="7d"

# ========================================
# 智谱AI (GLM)配置
# ========================================

# GLM API密钥
# 获取地址: https://open.bigmodel.cn/
GLM_API_KEY="your-glm-api-key-here"

# GLM模型选择
# 可选值: glm-4 | glm-4-flash
GLM_MODEL="glm-4-flash"

# GLM API基础URL（通常不需要修改）
GLM_API_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# ========================================
# Redis配置 (Upstash)
# ========================================

# Upstash Redis连接URL
# 格式: redis://default:password@host:port
REDIS_URL="redis://default:your-password@your-redis-host.upstash.io:6379"

# Redis连接池配置
REDIS_MAX_RETRIES="3"
REDIS_RETRY_DELAY="1000"

# ========================================
# Vercel部署配置
# ========================================

# Vercel环境（由Vercel自动设置）
VERCEL_ENV="production"

# Vercel部署URL（由Vercel自动设置）
VERCEL_URL=""

# ========================================
# 应用配置
# ========================================

# Node环境
NODE_ENV="production"

# 应用基础URL
BASE_URL="https://yourdomain.com"

# 前端URL（用于CORS配置）
FRONTEND_URL="https://yourdomain.com"

# API基础路径
API_BASE_PATH="/api"

# ========================================
# Cron任务安全
# ========================================

# Cron任务密钥（用于验证Vercel Cron请求）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="your-cron-secret-key-here"

# ========================================
# 管理员初始账号
# ========================================

# 管理员邮箱
ADMIN_EMAIL="admin@example.com"

# 管理员用户名
ADMIN_USERNAME="admin"

# 管理员密码（⚠️ 生产环境请务必修改！）
ADMIN_PASSWORD="change-me-in-production"

# ========================================
# 日志和监控（可选）
# ========================================

# Sentry DSN（错误追踪）
# SENTRY_DSN=""

# Sentry环境名称
# SENTRY_ENVIRONMENT="production"

# 日志级别
LOG_LEVEL="info"

# ========================================
# 邮件服务（可选，用于找回密码等功能）
# ========================================

# SMTP服务器地址
# SMTP_HOST="smtp.gmail.com"

# SMTP端口
# SMTP_PORT="587"

# SMTP用户名
# SMTP_USER="your-email@gmail.com"

# SMTP密码
# SMTP_PASS="your-app-password"

# 发件人邮箱
# SMTP_FROM="noreply@yourdomain.com"

# ========================================
# 限流配置
# ========================================

# API请求限流（每15分钟最多请求次数）
RATE_LIMIT_MAX="100"

# 登录请求限流（每15分钟最多尝试次数）
LOGIN_RATE_LIMIT_MAX="5"

# ========================================
# 文件上传配置（可选）
# ========================================

# 最大上传文件大小（字节）
# MAX_FILE_SIZE="5242880"

# 允许的文件类型
# ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# ========================================
# 缓存配置
# ========================================

# Redis缓存TTL（秒）
CACHE_TTL="3600"

# 静态资源缓存TTL（秒）
STATIC_CACHE_TTL="86400"

# ========================================
# 性能配置
# ========================================

# 数据库连接池大小
DB_POOL_SIZE="10"

# API超时时间（毫秒）
API_TIMEOUT="30000"

# Worker并发数（BullMQ）
WORKER_CONCURRENCY="3"

# ========================================
# 功能开关（可选）
# ========================================

# 启用注册功能
ENABLE_REGISTRATION="true"

# 启用AI生成功能
ENABLE_AI_GENERATION="true"

# 启用离线支持
ENABLE_OFFLINE_SUPPORT="true"

# 维护模式
MAINTENANCE_MODE="false"

# ========================================
# 第三方服务（可选）
# ========================================

# Google Analytics ID
# GA_TRACKING_ID=""

# Google Search Console验证码
# GOOGLE_SITE_VERIFICATION=""

# ========================================
# 开发环境专用配置
# ========================================

# 本地开发端口
# PORT="3000"

# 启用调试模式
# DEBUG="true"

# 跳过认证（仅限开发）
# SKIP_AUTH="false"
