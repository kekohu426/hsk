// GET /api/words/hsk/levels
export const getHSKLevels = async (req, res, next) => {
  try {
    const levels = await prisma.word.groupBy({
      by: ['hskLevel'],
      where: { isPublished: true },
      _count: { id: true },
      orderBy: { hskLevel: 'asc' }
    });

    const formattedLevels = levels.map(level => ({
      level: level.hskLevel,
      wordCount: level._count.id,
      description: getHSKDescription(level.hskLevel)
    }));

    res.json({ levels: formattedLevels });
  } catch (error) {
    next(error);
  }
};

function getHSKDescription(level) {
  const descriptions = {
    1: 'Basic everyday expressions and simple phrases',
    2: 'Simple conversations about familiar topics',
    3: 'Daily life communication with moderate fluency',
    4: 'Complex topics and abstract concepts',
    5: 'Read newspapers and magazines, express yourself fluently',
    6: 'Comprehensive Chinese proficiency, near-native level'
  };
  return descriptions[level] || '';
}

export const getWordSlugs = async (req, res, next) => {
  try {
    const page = Math.max(1, parseInt(req.query.page || '1', 10));
    const limit = Math.min(1000, Math.max(1, parseInt(req.query.limit || '500', 10)));
    const skip = (page - 1) * limit;

    const [words, landingPages] = await Promise.all([
      prisma.word.findMany({
        where: { isPublished: true },
        select: {
          slug: true,
          updatedAt: true
        },
        orderBy: { updatedAt: 'desc' },
        skip,
        take: limit
      }),
      prisma.wordLandingPage.findMany({
        where: { status: 'PUBLISHED' },
        select: {
          slug: true,
          updatedAt: true
        },
        orderBy: { updatedAt: 'desc' },
        skip,
        take: limit
      })
    ]);

    const mergedMap = new Map();
    [...words, ...landingPages].forEach((item) => {
      if (item?.slug) {
        const existing = mergedMap.get(item.slug);
        if (!existing || existing.updatedAt < item.updatedAt) {
          mergedMap.set(item.slug, item);
        }
      }
    });

    let mergedList = Array.from(mergedMap.values()).sort(
      (a, b) => b.updatedAt.getTime() - a.updatedAt.getTime()
    );
    mergedList = mergedList.slice(0, limit);

    res.json({
      slugs: mergedList.map((item) => item.slug),
      words: mergedList,
      page,
      limit,
      count: mergedList.length
    });
  } catch (error) {
    next(error);
  }
};

// 统一词汇详情API - 整合Words + WordLandingPage + UserWord
export const getWordDetail = async (req, res, next) => {
  try {
    const { slug } = req.params;
    const userId = req.user?.id;

    // 1. 获取落地页内容（如果存在）
    const landingPageRecord = await prisma.wordLandingPage.findFirst({
      where: { 
        slug,
        status: 'PUBLISHED'
      }
    });
    const landingPage = landingPageRecord
      ? {
          ...landingPageRecord,
          jsonContent: safeParseJSON(landingPageRecord.jsonContent, null)
        }
      : null;

    // 2. 获取基础词汇数据
    const wordRecord = await prisma.word.findFirst({
      where: { slug }
    });

    if (!wordRecord && !landingPage) {
      throw new AppError('Word not found', 404);
    }

    const word = wordRecord?.isPublished ? wordRecord : null;

    // 3. 获取用户学习数据（如果已登录）
    let userProgress = null;
    if (userId && wordRecord?.id) {
      userProgress = await prisma.userWord.findFirst({
        where: {
          userId,
          wordId: wordRecord.id
        }
      });
    }

    // 4. 返回整合数据
    res.json({
      word: word ? transformWordRecord(word) : buildWordFromLandingPage(landingPage, slug),
      landingPage: landingPage ? {
        content: landingPage.jsonContent,
        metrics: {
          seoScore: landingPage.seoScore,
          wordCount: landingPage.wordCount,
          exampleCount: landingPage.exampleCount,
          faqCount: landingPage.faqCount
        }
      } : null,
      userProgress: userProgress ? {
        id: userProgress.id,
        level: userProgress.level,
        repetitions: userProgress.repetitions,
        interval: userProgress.interval,
        nextReviewDate: userProgress.nextReviewDate,
        correctCount: userProgress.correctCount,
        wrongCount: userProgress.wrongCount,
        notes: userProgress.notes,
        addedAt: userProgress.createdAt
      } : null,
      hasLandingPage: !!landingPage
    });
  } catch (error) {
    next(error);
  }
};
