// Prisma Schema for ChineseMaster
// Database: SQLite (Development) / PostgreSQL (Production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  password      String
  role          String   @default("USER") // "USER" or "ADMIN"
  
  // Profile
  avatar        String?
  preferredLang String   @default("en") // en, ja, ko
  
  // Subscription
  isPremium     Boolean  @default(false)
  premiumUntil  DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  userWords     UserWord[]
  learningSessions LearningSession[]
  articleViews  ArticleView[]
  
  @@map("users")
}

// 词条表 - 统一的词汇内容管理
model WordEntry {
  id            String   @id @default(uuid())
  
  // 基础信息
  word          String   @unique  // 词汇本身（如"学校"）
  slug          String   @unique  // URL友好标识（如"xuexiao"）
  hskLevel      Int                // HSK等级 1-6
  
  // AI生成的完整内容（JSON格式）
  contentJson   String            // 存储完整的词条JSON（包含所有字段）
  
  // 状态管理
  status        String   @default("PENDING_IMPORT")  
  // PENDING_IMPORT(待生成) | GENERATING(生成中) | GENERATED(已生成) | PUBLISHED(已发布) | FAILED(生成失败)
  
  // AI生成相关
  aiPrompt      String?           // 生成时使用的提示词
  aiResponse    String?           // AI原始响应
  aiModel       String?           // 使用的AI模型（如"GLM-4"）
  generateError String?           // 生成失败的错误信息
  
  // 时间戳
  importedAt    DateTime @default(now())  // 导入时间
  generatedAt   DateTime?                 // 生成完成时间
  publishedAt   DateTime?                 // 发布时间
  updatedAt     DateTime @updatedAt
  
  // SEO与统计字段
  seoScore      Float?            // SEO评分
  wordCount     Int?              // 内容字数
  
  // 关联
  userWords     UserWord[]        // 用户学习记录
  
  @@index([status])
  @@index([hskLevel])
  @@index([importedAt])
  @@index([slug])
  @@map("word_entries")
}

// 用户词库关联表
model UserWord {
  id            String   @id @default(uuid())
  userId        String
  wordEntryId   String   // 关联到WordEntry
  
  // 学习状态（简化版，后续可扩展SRS）
  status        String   @default("PENDING") // "PENDING"(待学习), "LEARNING"(学习中), "MASTERED"(已掌握)
  
  // SRS (Spaced Repetition System) fields - 保留用于后续扩展
  repetitions   Int      @default(0) // 复习次数
  easeFactor    Float    @default(2.5) // SM-2 ease factor
  interval      Int      @default(0) // 复习间隔（天）
  nextReview    DateTime @default(now()) // 下次复习时间
  
  // Learning metadata
  isFavorite    Boolean  @default(false)
  notes         String?
  source        String?  // "HSK Library", "Article", "Text Analyzer"
  
  // Statistics
  correctCount  Int      @default(0)
  wrongCount    Int      @default(0)
  totalTime     Int      @default(0) // 学习总时长（秒）
  
  addedAt       DateTime @default(now())
  lastReviewAt  DateTime?
  
  // Relations
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordEntry     WordEntry   @relation(fields: [wordEntryId], references: [id], onDelete: Cascade)
  
  @@unique([userId, wordEntryId])
  @@index([userId, status])
  @@index([userId, nextReview])
  @@map("user_words")
}

// 文章表
model Article {
  id                String   @id @default(uuid())
  title             String
  titleEn           String?
  slug              String   @unique
  
  // Content (JSON stored as String)
  content           String   // JSON: [{cn, pinyin, en, type: "paragraph/dialogue"}, ...]
  excerpt           String
  
  // Difficulty
  level             String   // "BEGINNER", "INTERMEDIATE", "ADVANCED"
  hskLevel          String?  // "HSK 2-3"
  readTime          Int      // 分钟
  wordCount         Int
  
  // New words in this article (JSON stored as String)
  newWords          String   // JSON: [{wordId, word, pinyin, meaning, hsk}, ...]
  
  // Quiz (JSON stored as String)
  quiz              String?  // JSON: [{question, options: [], answer: index}, ...]
  
  // Media
  coverImage        String?
  audioUrl          String?
  
  // SEO
  metaTitle         String?
  metaDescription   String?
  
  // Status
  status            String   @default("DRAFT") // "DRAFT", "PUBLISHED", "ARCHIVED"
  publishedAt       DateTime?
  viewCount         Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  views             ArticleView[]
  
  @@index([status, publishedAt])
  @@index([level])
  @@map("articles")
}

// 文章阅读记录
model ArticleView {
  id            String   @id @default(uuid())
  userId        String?
  articleId     String
  
  readProgress  Int      @default(0) // 0-100
  completedQuiz Boolean  @default(false)
  quizScore     Int?     // 0-100
  
  createdAt     DateTime @default(now())
  
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  @@index([userId, articleId])
  @@map("article_views")
}

// 学习会话记录
model LearningSession {
  id            String   @id @default(uuid())
  userId        String
  
  // Session data
  wordsReviewed Int      @default(0)
  wordsCorrect  Int      @default(0)
  wordsWrong    Int      @default(0)
  totalTime     Int      @default(0) // 秒
  
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, startedAt])
  @@map("learning_sessions")
}

// AI配置表（管理端）
model AIConfig {
  id            String   @id @default(uuid())
  modelName     String   @unique // "GLM-4", "GLM-4-Flash", "GPT-3.5"
  apiKey        String
  apiUrl        String
  
  isActive      Boolean  @default(false)
  isDefault     Boolean  @default(false)
  
  // Cost tracking
  tokenUsed     Int      @default(0) // SQLite不支持BigInt，用Int
  estimatedCost Float    @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("ai_configs")
}
